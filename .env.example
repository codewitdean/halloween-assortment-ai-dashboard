# Optional server-side question interpretation. Leave both blank for deterministic evidence mode.
OPENAI_API_KEY=
# Set a model with Responses API Structured Outputs support for your account.
OPENAI_MODEL=
# Optional writable folder for rationale revision history. Defaults to .local/rationales.
# A single trusted local Node server is supported; no authenticated approval identity is claimed.
RATIONALE_DATA_DIR=
